<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ManagedCode.Playwright.Stealth</PackageId>
    <Title>ManagedCode.Playwright.Stealth</Title>
    <Description>Stealth evasion library for Microsoft.Playwright (.NET). Provides 31 configurable detection vectors while preserving native Chromium APIs, synchronizing page and worker identities, and keeping HTTP User-Agent and client hints consistent. Includes headless and headful regression coverage across 10 public bot-detection sites.</Description>
    <PackageTags>playwright;stealth;bot-detection;headless;fingerprint;anti-detect;web-scraping;automation</PackageTags>
    <RootNamespace>ManagedCode.Playwright.Stealth</RootNamespace>
    <AssemblyName>ManagedCode.Playwright.Stealth</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/js/*.js" />
  </ItemGroup>

</Project>
